{
  "schema": "colorskip.rules/1",
  "name": "ColorSkip 示例规则",
  "version": 1,
  "rules": [
    {
      "id": "example.node.skip",
      "name": "示例应用开屏",
      "packages": ["com.example.app"],
      "keywords": ["跳过", "Skip", "跳过广告"],
      "excludeKeywords": ["跳过教程", "跳过引导"],
      "viewIds": ["skip", "splash_skip"],
      "cooldownMs": 2500,
      "priority": 100
    },
    {
      "id": "example.ad.close",
      "name": "广告弹窗关闭",
      "packages": ["com.example.app"],
      "keywords": ["关闭广告", "关闭"],
      "excludeKeywords": ["关闭账号", "关闭会员"],
      "requireAdContext": true,
      "priority": 70
    },
    {
      "id": "example.viewid.skip",
      "name": "广告 SDK 跳过控件",
      "packages": ["com.example.app"],
      "viewIds": ["tt_splash_skip_btn", "ksad_skip_view", "ad_skip"],
      "priority": 120
    },
    {
      "id": "example.flutter.coordinate",
      "name": "Flutter 开屏坐标",
      "packages": ["com.example.flutterapp"],
      "clickMode": "coordinate",
      "xPercent": 91,
      "yPercent": 7,
      "delayMs": 800,
      "cooldownMs": 5000,
      "requireAdContext": true,
      "priority": 200
    }
  ]
}
